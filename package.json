  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "3"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.21.1",
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3"
  },
  "private": true
}
